{
  "name": "Riddlex preview",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postStartCommand": "nohup python3 -m http.server 8000 --bind 0.0.0.0 </dev/null >/tmp/riddlex-preview.log 2>&1 &",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Riddlex preview",
      "onAutoForward": "notify"
    }
  }
}
