rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner() {
      return signedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == "walid.ibnwhakil@gmail.com"
        || request.auth.token.email == "iwhakil@gmail.com"
        || request.auth.token.riddlexOwner == true
      );
    }
    function hourNow() {
      return int(request.time.toMillis() / 3600000);
    }
    function validImage(data) {
      return !("image" in data) || (
        data.image is string
        && data.image.size() > 20
        && data.image.size() < 150000
        && data.image.matches("^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$")
      );
    }
    function noAdultPicture(data) {
      return data.adult == false || !("image" in data);
    }

    match /riddlex_slots/{id} {
      allow create: if signedIn()
        && id.split("~")[0] == request.auth.uid
        && id.split("~").size() == 3
        && int(id.split("~")[1]) == hourNow()
        && int(id.split("~")[2]) >= 0
        && int(id.split("~")[2]) <= 4
        && request.resource.data.keys().hasOnly(["slug"])
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() < 120
        && request.resource.size() < 2000;
      allow read: if signedIn() && id.split("~")[0] == request.auth.uid;
    }

    match /riddlex_entries/{slug} {
      allow get: if resource == null
        || resource.data.status in ["approved", "confirmed"]
        || owner()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow list: if resource.data.status in ["approved", "confirmed"]
        || owner();

      allow create: if signedIn()
        && slug == request.resource.data.slug
        && slug.size() > 0
        && slug.size() < 120
        && request.resource.data.keys().hasOnly([
          "slug", "nameEn", "nameBn", "adult", "answers", "image", "status",
          "confirmations", "confirmers", "createdBy", "createdAt", "updatedAt", "slot"
        ])
        && request.resource.data.nameEn is string
        && request.resource.data.nameEn.size() >= 2
        && request.resource.data.nameEn.size() <= 60
        && request.resource.data.nameEn.matches('^[^<>@:/]{2,60}$')
        && request.resource.data.nameBn is string
        && request.resource.data.nameBn.size() <= 80
        && request.resource.data.adult is bool
        && request.resource.data.answers is list
        && request.resource.data.answers.size() > 0
        && request.resource.data.answers.size() <= 36
        && request.resource.data.status == "pending"
        && request.resource.data.confirmations == 1
        && request.resource.data.confirmers == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.slot is int
        && request.resource.data.slot >= 0
        && request.resource.data.slot <= 4
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validImage(request.resource.data)
        && noAdultPicture(request.resource.data)
        && request.resource.size() < 220000
        && exists(/databases/$(database)/documents/riddlex_slots/$(request.auth.uid + "~" + string(hourNow()) + "~" + string(request.resource.data.slot)))
        && get(/databases/$(database)/documents/riddlex_slots/$(request.auth.uid + "~" + string(hourNow()) + "~" + string(request.resource.data.slot))).data.slug == slug;

      allow update: if signedIn()
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.nameEn == resource.data.nameEn
        && request.resource.data.nameBn == resource.data.nameBn
        && request.resource.data.adult == resource.data.adult
        && request.resource.data.answers is list
        && request.resource.data.answers.size() > 0
        && request.resource.data.answers.size() <= 36
        && request.resource.data.answers == resource.data.answers
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["confirmations","confirmers","updatedAt"])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (("image" in resource.data) == ("image" in request.resource.data))
        && (!("image" in resource.data) || request.resource.data.image == resource.data.image)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.confirmers.size() == resource.data.confirmers.size() + 1
        && request.resource.data.confirmers.size() <= 12
        && request.auth.uid in request.resource.data.confirmers
        && !(request.auth.uid in resource.data.confirmers)
        && request.resource.data.confirmations == resource.data.confirmations + 1
        && request.resource.data.confirmations <= 12
        && (
          request.resource.data.status == resource.data.status
        )
        && request.resource.size() < 220000
        || owner()
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.nameEn == resource.data.nameEn
        && request.resource.data.answers == resource.data.answers
        && request.resource.data.status in ["approved", "rejected", "pending", "confirmed"]
        && request.resource.size() < 220000;

      allow delete: if owner();
    }

    // Each play path is an immutable, privately moderated suggestion.
    match /riddlex_suggestions/{id} {
      allow get: if owner() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow list: if owner();
      allow create: if signedIn()
        && id.size() > 0 && id.size() < 120
        && request.resource.data.keys().hasOnly([
          "nameEn","nameBn","adult","category","answers","knownIds",
          "status","createdBy","slot","createdAt","image"
        ])
        && request.resource.data.nameEn is string
        && request.resource.data.nameEn.size() >= 2
        && request.resource.data.nameEn.size() <= 60
        && request.resource.data.nameEn.matches('^[^<>@:/]{2,60}
)
        && request.resource.data.nameBn is string
        && request.resource.data.nameBn.size() <= 80
        && request.resource.data.adult is bool
        && request.resource.data.category in ["character","animal","object"]
        && request.resource.data.answers is list
        && request.resource.data.answers.size() > 0
        && request.resource.data.answers.size() <= 512
        && request.resource.data.knownIds is list
        && request.resource.data.knownIds.size() <= 10
        && request.resource.data.status == "pending"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.slot is int
        && request.resource.data.slot >= 0 && request.resource.data.slot <= 4
        && request.resource.data.createdAt == request.time
        && validImage(request.resource.data) && noAdultPicture(request.resource.data)
        && request.resource.size() < 350000
        && exists(/databases/$(database)/documents/riddlex_slots/$(request.auth.uid + "~" + string(hourNow()) + "~" + string(request.resource.data.slot)))
        && get(/databases/$(database)/documents/riddlex_slots/$(request.auth.uid + "~" + string(hourNow()) + "~" + string(request.resource.data.slot))).data.slug == id;
      allow update: if owner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","resolvedId","reviewedAt"])
        && request.resource.data.status in ["approved","rejected","pending"]
        && request.resource.data.reviewedAt == request.time;
      allow delete: if owner();
    }

    // The public game may read ONLY owner-reviewed facts, never raw player paths.
    match /riddlex_owner_records/{id} {
      allow get, list: if true;
      allow create, update: if owner()
        && id.size() > 0 && id.size() <= 140
        && request.resource.data.keys().hasOnly([
          "nameEn","nameBn","adult","category","answers","image","credit","mode",
          "revision","updatedAt"
        ])
        && request.resource.data.nameEn is string
        && request.resource.data.nameEn.size() >= 2 && request.resource.data.nameEn.size() <= 80
        && request.resource.data.nameBn is string && request.resource.data.nameBn.size() <= 80
        && request.resource.data.adult is bool
        && request.resource.data.category in ["real","fictional","animal","object"]
        && request.resource.data.answers is list
        && request.resource.data.answers.size() > 0 && request.resource.data.answers.size() <= 512
        && request.resource.data.image is string && request.resource.data.image.size() < 150000
        && request.resource.data.credit is string && request.resource.data.credit.size() <= 2000
        && (request.resource.data.adult == false || request.resource.data.image == "")
        && request.resource.data.mode in ["patch","new"]
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time
        && request.resource.size() < 350000;
      allow delete: if owner();
      match /history/{version} {
        allow read, create: if owner();
        allow update, delete: if false;
      }
    }
  }
}
