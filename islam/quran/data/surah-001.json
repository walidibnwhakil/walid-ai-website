{
  "surah": 1,
  "verses": [
    {
      "verse": 1,
      "arabic": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
      "pronunciation": "বিসমিল্লাহির রাহমানির রাহীম।",
      "translation": "শুরু করছি পরম করুণাময়, অসীম দয়ালু আল্লাহর নামে।"
    },
    {
      "verse": 2,
      "arabic": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
      "pronunciation": "আলহামদু লিল্লাহি রব্বিল আলামীন।",
      "translation": "সমস্ত প্রশংসা আল্লাহর জন্য, যিনি সমগ্র সৃষ্টিজগতের প্রতিপালক।"
    },
    {
      "verse": 3,
      "arabic": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
      "pronunciation": "আর-রাহমানির রাহীম।",
      "translation": "তিনি পরম করুণাময়, অসীম দয়ালু।"
    },
    {
      "verse": 4,
      "arabic": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
      "pronunciation": "মালিকি ইয়াওমিদ্দীন।",
      "translation": "তিনি বিচার দিনের মালিক।"
    },
    {
      "verse": 5,
      "arabic": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
      "pronunciation": "ইয়্যাকা না‘বুদু ওয়া ইয়্যাকা নাস্তা‘ঈন।",
      "translation": "আমরা একমাত্র তোমারই ইবাদত করি এবং একমাত্র তোমারই সাহায্য চাই।"
    },
    {
      "verse": 6,
      "arabic": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
      "pronunciation": "ইহদিনাস সিরাতাল মুস্তাকীম।",
      "translation": "আমাদের সরল পথ দেখাও।"
    },
    {
      "verse": 7,
      "arabic": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
      "pronunciation": "সিরাতাল্লাযীনা আন‘আমতা ‘আলাইহিম, গইরিল মাগদূবি ‘আলাইহিম ওয়ালাদ্দল্লীন।",
      "translation": "তাদের পথ, যাদের তুমি অনুগ্রহ করেছ; তাদের পথ নয়, যারা তোমার ক্রোধের পাত্র হয়েছে, আর তাদের পথও নয়, যারা পথভ্রষ্ট হয়েছে।"
    }
  ]
}
