{
  "surah": 1,
  "verses": [
    {
      "verse": 1,
      "arabic": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
      "pronunciation": "বিসমিল্লাহির রাহমানির রাহীম।",
      "translation": "রহমান, রহীম [১] আল্লাহ্‌র নামে [২]"
    },
    {
      "verse": 2,
      "arabic": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
      "pronunciation": "আলহামদু লিল্লাহি রব্বিল আলামীন।",
      "translation": "সকল ‘হাম্‌দ’ [১] আল্লাহ্‌র [২] , যিনি সৃষ্টিকুলের [৩] রব [৪],"
    },
    {
      "verse": 3,
      "arabic": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
      "pronunciation": "আর-রাহমানির রাহীম।",
      "translation": "দয়াময়, পরম দয়ালু [১],"
    },
    {
      "verse": 4,
      "arabic": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
      "pronunciation": "মালিকি ইয়াওমিদ্দীন।",
      "translation": "বিচার দিনের মালিক [১]।"
    },
    {
      "verse": 5,
      "arabic": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
      "pronunciation": "ইয়্যাকা না‘বুদু ওয়া ইয়্যাকা নাস্তা‘ঈন।",
      "translation": "আমরা শুধু আপনারই ‘ইবাদাত [১] করি [২], এবং শুধু আপনারই সাহায্য প্রার্থনা করি [৩],"
    },
    {
      "verse": 6,
      "arabic": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
      "pronunciation": "ইহদিনাস সিরাতাল মুস্তাকীম।",
      "translation": "আমাদেরকে সরল পথের হিদায়াত দিন [১]"
    },
    {
      "verse": 7,
      "arabic": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيْهِمۡ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمۡ وَلَا ٱلضَّآلِّينَ",
      "pronunciation": "সিরাতাল্লাযীনা আন‘আমতা ‘আলাইহিম, গইরিল মাগদূবি ‘আলাইহিম ওয়ালাদ্দল্লীন।",
      "translation": "তাদের পথ, যাদেরকে আপনি নি‘আমত দিয়েছেন [১], যাদের উপর আপনার ক্রোধ আপতিত হয়নি [২] এবং যারা পথভ্রষ্টও নয় [৩]"
    }
  ]
}
