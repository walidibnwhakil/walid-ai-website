{
  "surah": 80,
  "verses": [
    {
      "verse": 1,
      "arabic": "عَبَسَ وَتَوَلَّىٰٓ",
      "translation": "তিনি ভ্ৰকুঞ্চিত করলেন এবং মুখ ফিরিয়ে নিলেন,",
      "pronunciation": "আবাসা ওয়া তাওয়াল্লা।"
    },
    {
      "verse": 2,
      "arabic": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ",
      "translation": "কারণ তাঁর কাছে অন্ধ লোকটি আসল।",
      "pronunciation": "আন জাআহুল-আ‘মা।"
    },
    {
      "verse": 3,
      "arabic": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "translation": "আর কিসে আপনাকে জানাবে যে, --- সে হয়ত পরিশুদ্ধ হত",
      "pronunciation": "ওয়া মা ইউদরীকা লাআল্লাহু ইয়াযযাক্কা।"
    },
    {
      "verse": 4,
      "arabic": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ",
      "translation": "অথবা উপদেশ গ্ৰহণ করত, ফলে সে উপদেশ তার উপকারে আসত।",
      "pronunciation": "আও ইয়াযযাক্কারু ফাতানফাআহুয-যিকরা।"
    },
    {
      "verse": 5,
      "arabic": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ",
      "translation": "আর যে পরোয়া করে না",
      "pronunciation": "আম্মা মানিসতাগনা।"
    },
    {
      "verse": 6,
      "arabic": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "translation": "আপনি তার প্রতি মনোযোগ দিয়েছেন।",
      "pronunciation": "ফাআনতা লাহু তাসাদ্দা।"
    },
    {
      "verse": 7,
      "arabic": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ",
      "translation": "অথচ সে নিজে পরিশুদ্ধ না হলে আপনার কোনো দায়িত্ব নেই,",
      "pronunciation": "ওয়ামা ‘ালায়কা আল্লা ইয়ায্যাক্কা।"
    },
    {
      "verse": 8,
      "arabic": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ",
      "translation": "অপরদিকে যে আপনার কাছে ছুটে এলো,",
      "pronunciation": "ওয়াআম্মা মান জাআকা ইয়াস‘আ।"
    },
    {
      "verse": 9,
      "arabic": "وَهُوَ يَخۡشَىٰ",
      "translation": "আর সে সশঙ্কচিত্ত,",
      "pronunciation": "ওয়া হুওয়া ইয়াখশা।"
    },
    {
      "verse": 10,
      "arabic": "فَأَنتَ عَنۡهُ تَلَهَّىٰ",
      "translation": "আপনি তার থেকে উদাসীন হলেন;",
      "pronunciation": "ফাআনতা ‘ানহু তালাহ্হা।"
    },
    {
      "verse": 11,
      "arabic": "كَلَّآ إِنَّهَا تَذۡكِرَةࣱ",
      "translation": "কখনো নয়, এটা তো উপদেশ বাণী,",
      "pronunciation": "কাল্লা ইন্নাহা তাযকিরাহ।"
    },
    {
      "verse": 12,
      "arabic": "فَمَن شَآءَ ذَكَرَهُۥ",
      "translation": "কাজেই যে ইচ্ছে করবে সে এটা স্মরণ রাখবে,",
      "pronunciation": "ফামান শাআ যাকারাহু।"
    },
    {
      "verse": 13,
      "arabic": "فِي صُحُفࣲ مُّكَرَّمَةࣲ",
      "translation": "এটা আছে মর্যাদা সম্পন্ন লিপিসমূহে",
      "pronunciation": "ফী সুহুফ ম্মুকার্রামাহ।"
    },
    {
      "verse": 14,
      "arabic": "مَّرۡفُوعَةࣲ مُّطَهَّرَةِۭ",
      "translation": "যা উন্নত, পবিত্ৰ,",
      "pronunciation": "ম্মারফূ‘াত ম্মুতাহ্হারাহ।"
    },
    {
      "verse": 15,
      "arabic": "بِأَيۡدِي سَفَرَةࣲ",
      "translation": "লেখক বা দূতদের হাতে।",
      "pronunciation": "বিআয়দী সাফারাহ।"
    },
    {
      "verse": 16,
      "arabic": "كِرَامِۭ بَرَرَةࣲ",
      "translation": "(যারা) মহাসম্মানিত ও নেককার।",
      "pronunciation": "কিরামি বারারাহ।"
    },
    {
      "verse": 17,
      "arabic": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ",
      "translation": "মানুষ ধ্বংস হোক! সে কত অকৃতজ্ঞ!",
      "pronunciation": "ক্বুতিলা আলইনসানু মা আকফারাহু।"
    },
    {
      "verse": 18,
      "arabic": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ",
      "translation": "তিনি তাকে কোন বস্তু থেকে সৃষ্টি করেছেন?",
      "pronunciation": "মিন আয়্য শাইইন খালাক্বাহু।"
    },
    {
      "verse": 19,
      "arabic": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "translation": "শুক্রবিন্দু থেকে, তিনি তাকে সৃষ্টি করেন, পরে তার পরিমিত বিকাশ সাধন করেন,",
      "pronunciation": "মিন ন্নুতফাতইন্ খালাক্বাহু ফাক্বাদ্দারাহু।"
    },
    {
      "verse": 20,
      "arabic": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "translation": "তারপর তার জন্য পথ সহজ করে দেন;",
      "pronunciation": "ছুম্মা আস্সাবীলা ইয়াস্সারাহু।"
    },
    {
      "verse": 21,
      "arabic": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ",
      "translation": "এরপর তার মৃত্যু ঘটান এবং তাকে কবরস্থ করেন।",
      "pronunciation": "ছুম্মা আমাতাহু ফাআক্ববারাহু।"
    },
    {
      "verse": 22,
      "arabic": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "translation": "এরপর যখন ইচ্ছে তিনি তাকে পুনর্জীবিত করবেন।",
      "pronunciation": "ছুম্মা ইযা শাআ আনশারাহু।"
    },
    {
      "verse": 23,
      "arabic": "كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ",
      "translation": "কখনো নয়, তিনি তাকে যা আদেশ করেছেন, সে এখনো তা পূর্ণ করেনি।",
      "pronunciation": "কাল্লা লাম্মা ইয়াক্বদি মা আমারাহু।"
    },
    {
      "verse": 24,
      "arabic": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "translation": "অতঃপর মানুষ যেন তার খাদ্যের প্রতি লক্ষ্য করে!",
      "pronunciation": "ফালয়ানজুরি আলইনসানু ইলা তা‘ামিহি।"
    },
    {
      "verse": 25,
      "arabic": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبࣰّا",
      "translation": "নিশ্চয় আমরা প্রচুর বারি বর্ষণ করি,",
      "pronunciation": "আন্না সাবাবনা আল-মাআ সাব্ব।"
    },
    {
      "verse": 26,
      "arabic": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقࣰّا",
      "translation": "তারপর আমরা যমীনকে যথাযথভাবে বিদীর্ণ করি;",
      "pronunciation": "ছুম্মা শাক্বাক্বনা আলআরদা শাক্ব্ক্ব।"
    },
    {
      "verse": 27,
      "arabic": "فَأَنۢبَتۡنَا فِيهَا حَبࣰّا",
      "translation": "অতঃপর তাতে আমরা উৎপন্ন করি শস্য;",
      "pronunciation": "ফাআনবাতনা ফীহা হাব্ব।"
    },
    {
      "verse": 28,
      "arabic": "وَعِنَبࣰا وَقَضۡبࣰا",
      "translation": "আঙ্গুর, শাক-সব্জি,",
      "pronunciation": "ওয়া‘িনাব ওয়াক্বাদব।"
    },
    {
      "verse": 29,
      "arabic": "وَزَيۡتُونࣰا وَنَخۡلࣰا",
      "translation": "যায়তূন, খেজুরগাছ,",
      "pronunciation": "ওয়াযায়তূন ওয়ানাখল।"
    },
    {
      "verse": 30,
      "arabic": "وَحَدَآئِقَ غُلۡبࣰا",
      "translation": "অনেক গাছবিশিষ্ট উদ্যান,",
      "pronunciation": "ওয়াহাদাইক্বা গুলব।"
    },
    {
      "verse": 31,
      "arabic": "وَفَٰكِهَةࣰ وَأَبࣰّا",
      "translation": "ফল এবং গবাদি খাদ্য,",
      "pronunciation": "ওয়াফাকিহাত ওয়াআব্ব।"
    },
    {
      "verse": 32,
      "arabic": "مَّتَٰعࣰا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",
      "translation": "এগুলো তোমাদের ও তোমাদের চতুস্পদ জন্তুদের ভোগের জন্য।",
      "pronunciation": "ম্মাতা‘ ল্লাকুম ওয়ালিআন‘ামিকুম।"
    },
    {
      "verse": 33,
      "arabic": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "translation": "অতঃপর যখন তীক্ষ্ন আওয়াজ আসবে,",
      "pronunciation": "ফাইযা জাআতি আস্সাখ্খাহ।"
    },
    {
      "verse": 34,
      "arabic": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ",
      "translation": "সেদিন মানুষ পালিয়ে যাবে তার ভাইয়ের কাছ থেকে",
      "pronunciation": "ইয়াওমা ইয়াফির্রু আলমারহ মিন আখীহ।"
    },
    {
      "verse": 35,
      "arabic": "وَأُمِّهِۦ وَأَبِيهِ",
      "translation": "এবং তার মাতা, তার পিতা,",
      "pronunciation": "ওয়াউম্মিহি ওয়াআবীহ।"
    },
    {
      "verse": 36,
      "arabic": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
      "translation": "তার পত্নী ও তার সন্তান থেকে,",
      "pronunciation": "ওয়াসাহিবাতিহি ওয়াবানীহ।"
    },
    {
      "verse": 37,
      "arabic": "لِكُلِّ ٱمۡرِيࣲٕ مِّنۡهُمۡ يَوۡمَئِذࣲ شَأۡنࣱ يُغۡنِيهِ",
      "translation": "সেদিন তাদের প্রত্যেকের হবে এমন গুরুতর অবস্থা যা তাকে সম্পূর্ণরূপে ব্যস্ত রাখবে।",
      "pronunciation": "লিকুল্লি ইমরী ম্মিনহুম ইয়াওমাইয শান ইয়ুগনীহ।"
    },
    {
      "verse": 38,
      "arabic": "وُجُوهࣱ يَوۡمَئِذࣲ مُّسۡفِرَةࣱ",
      "translation": "অনেক চেহারা সেদিন হবে উজ্জ্বল,",
      "pronunciation": "উজূহ ইয়াওমাইয ম্মুসফিরাহ।"
    },
    {
      "verse": 39,
      "arabic": "ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ",
      "translation": "সহাস্য ও প্রফুল্ল,",
      "pronunciation": "দাহিকাত ম্মুসতাবশিরাহ।"
    },
    {
      "verse": 40,
      "arabic": "وَوُجُوهࣱ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةࣱ",
      "translation": "আর অনেক চেহারা সেদিন হবে ধূলিধূসর",
      "pronunciation": "ওয়াউজূহ ইয়াওমাইযইন্ ‘ালায়হা গাবারাহ।"
    },
    {
      "verse": 41,
      "arabic": "تَرۡهَقُهَا قَتَرَةٌ",
      "translation": "সেগুলোকে আচ্ছন্ন করবে কালিমা।",
      "pronunciation": "তারহাক্বুহা ক্বাতারাহ।"
    },
    {
      "verse": 42,
      "arabic": "أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ",
      "translation": "এরাই কাফির ও পাপাচারী।",
      "pronunciation": "উলাআইকা হুমু আলকাফারাতু আলফাজারাহ।"
    }
  ]
}
