{
  "surah": 81,
  "verses": [
    {
      "verse": 1,
      "arabic": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ",
      "translation": "সূর্যকে যখন নিষ্প্রভ করা হবে,",
      "pronunciation": "ইযা আশ্শামসু কূরাত।"
    },
    {
      "verse": 2,
      "arabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ",
      "translation": "আর যখন নক্ষত্ররাজি খসে পড়বে,",
      "pronunciation": "ওয়াইযা আন্নুজূমু ইনকাদারাত।"
    },
    {
      "verse": 3,
      "arabic": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ",
      "translation": "আর পর্বতসমূহকে যখন চলমান করা হবে,",
      "pronunciation": "ওয়াইযা আল-জিবালু সুয়্যরাত।"
    },
    {
      "verse": 4,
      "arabic": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ",
      "translation": "আর যখন পূর্ণগর্ভা মাদী উট উপেক্ষিত হবে,",
      "pronunciation": "ওয়াইযা আল-ইশারু উত্তিলাত।"
    },
    {
      "verse": 5,
      "arabic": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ",
      "translation": "আর যখন বন্য পশুগুলো একত্র করা হবে,",
      "pronunciation": "ওয়াইযা আল-উহূশু হুশিরাত।"
    },
    {
      "verse": 6,
      "arabic": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ",
      "translation": "আর যখন সাগরকে অগ্নি-উত্তাল করা হবে,",
      "pronunciation": "ওয়াইযা আল-বিহারু সুজ্জিরাত।"
    },
    {
      "verse": 7,
      "arabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ",
      "translation": "আর যখন আত্মাগুলোকে সমগোত্রীয়দের সাথে মিলিয়ে দেয়া হবে,",
      "pronunciation": "ওয়াইযা আন্নুফূসু যূজাত।"
    },
    {
      "verse": 8,
      "arabic": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ",
      "translation": "আর যখন জীবন্ত সমাধিস্থ কন্যাকে জিজ্ঞেস করা হবে,",
      "pronunciation": "ওয়াইযা আল-মাওহদাতু সুইলাত।"
    },
    {
      "verse": 9,
      "arabic": "بِأَيِّ ذَنۢبࣲ قُتِلَتۡ",
      "translation": "কী অপরাধে তাকে হত্যা করা হয়েছিল?",
      "pronunciation": "বিআয়্য যানব ক্বুতিলাত।"
    },
    {
      "verse": 10,
      "arabic": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ",
      "translation": "আর যখন আমলনামাগুলো উন্মোচিত করা হবে,",
      "pronunciation": "ওয়াইযা আস্সুহুফু নুশিরাত।"
    },
    {
      "verse": 11,
      "arabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ",
      "translation": "আর যখন আসমানের আবরণ অপসারিত করা হবে,",
      "pronunciation": "ওয়াইযা আস-সামাউ কুশিতাত।"
    },
    {
      "verse": 12,
      "arabic": "وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ",
      "translation": "আর যখন জাহান্নামকে ভীষণভাবে প্ৰজ্জ্বলিত করা হবে,",
      "pronunciation": "ওয়াইযা আল-জাহীমু সুআ্ইরাত।"
    },
    {
      "verse": 13,
      "arabic": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ",
      "translation": "আর যখন জান্নাত নিকটবর্তী করা হবে,",
      "pronunciation": "ওয়াইযা আল-জান্নাতু উযলিফাত।"
    },
    {
      "verse": 14,
      "arabic": "عَلِمَتۡ نَفۡسࣱ مَّآ أَحۡضَرَتۡ",
      "translation": "তখন প্ৰত্যেক ব্যক্তিই জানবে সে কি উপস্থিত করেছে।",
      "pronunciation": "আল-িমাত নাফস ম্মা আহদারাত।"
    },
    {
      "verse": 15,
      "arabic": "فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ",
      "translation": "সুতরাং আমি শপথ করছি পশ্চাদপসরণকারী নক্ষত্রের,",
      "pronunciation": "ফালা উক্বসিমু বিলখুন্নাস।"
    },
    {
      "verse": 16,
      "arabic": "ٱلۡجَوَارِ ٱلۡكُنَّسِ",
      "translation": "যা চলমান, অপসৃয়মাণ,",
      "pronunciation": "আল-জাওয়ারি আল-কুন্নাস।"
    },
    {
      "verse": 17,
      "arabic": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ",
      "translation": "শপথ রাতের যখন তা শেষ হয়",
      "pronunciation": "ওয়াল-্লায়লি ইযা আসআস।"
    },
    {
      "verse": 18,
      "arabic": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ",
      "translation": "শপথ প্ৰভাতের যখন তার আবির্ভাব হয়,",
      "pronunciation": "ওয়াল-স্সুবহি ইযা তানাফ্ফাস।"
    },
    {
      "verse": 19,
      "arabic": "إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ",
      "translation": "নিশ্চয়ই এ কুরআন সম্মানিত রাসূলের আনীত বাণী",
      "pronunciation": "ইন্নাহু লাক্বাওলু রাসূল কারীম।"
    },
    {
      "verse": 20,
      "arabic": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينࣲ",
      "translation": "যে সামর্থ্যশালী, আরশের মালিকের কাছে মর্যাদা সম্পন্ন,",
      "pronunciation": "যী ক্বূতইন্ ইনদা যী আল-আরশি মাকীন।"
    },
    {
      "verse": 21,
      "arabic": "مُّطَاعࣲ ثَمَّ أَمِينࣲ",
      "translation": "সে মান্য সেখানে, বিশ্বাসভাজন।",
      "pronunciation": "ম্মুতাআ ছাম্মা আমীন।"
    },
    {
      "verse": 22,
      "arabic": "وَمَا صَاحِبُكُم بِمَجۡنُونࣲ",
      "translation": "আর তোমাদের সাথী উন্মাদ নন,",
      "pronunciation": "ওয়ামা সাহিবুকুম বিমাজনূন।"
    },
    {
      "verse": 23,
      "arabic": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ",
      "translation": "তিনি তো তাকে স্পষ্ট দিগন্তে দেখেছেন,",
      "pronunciation": "ওয়া লাকাদ রাআহু বিল-উফুকিল-মুবীন।"
    },
    {
      "verse": 24,
      "arabic": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينࣲ",
      "translation": "তিনি গায়েবী বিষয় সম্পর্কে কৃপণ নয়।",
      "pronunciation": "ওয়ামা হুওয়া আল-া আল-গায়বি বিদানীন।"
    },
    {
      "verse": 25,
      "arabic": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ",
      "translation": "আর এটা কোনো অভিশপ্ত শয়তানের বাক্য নয়।",
      "pronunciation": "ওয়ামা হুওয়া বিক্বাওলি শায়তান র্রাজীম।"
    },
    {
      "verse": 26,
      "arabic": "فَأَيۡنَ تَذۡهَبُونَ",
      "translation": "কাজেই তোমরা কোথায় যাচ্ছ? !",
      "pronunciation": "ফাআয়না তাযহাবূন।"
    },
    {
      "verse": 27,
      "arabic": "إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ",
      "translation": "এ তো শুধু সৃষ্টিকুলের জন্য উপদেশ,",
      "pronunciation": "ইন হুওয়া ইল্লা যিকর ল্লিলআল-ামীন।"
    },
    {
      "verse": 28,
      "arabic": "لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ",
      "translation": "তোমাদের মধ্যে যে সরল পথে চলতে চায়, তার জন্য।",
      "pronunciation": "লিমান শাআ মিনকুম আন ইয়াসতাক্বীম।"
    },
    {
      "verse": 29,
      "arabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",
      "translation": "আর তোমরা ইচ্ছে করতে পার না, যদি না সৃষ্টিকুলের রব আল্লাহ্ ইচ্ছে করেন।",
      "pronunciation": "ওয়ামা তাশাঊনা ইল্লা আন ইয়াশাআ আল্লাহু রাব্বু আল-আল-ামীন।"
    }
  ]
}
