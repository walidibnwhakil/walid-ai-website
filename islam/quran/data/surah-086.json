{
  "surah": 86,
  "verses": [
    {
      "verse": 1,
      "arabic": "وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "translation": "শপথ আসমানের এবং রাতে যা আবির্ভূত হয় তার;",
      "pronunciation": "ওয়াস-সামাঈ ওয়ালত্তারিক্ব।"
    },
    {
      "verse": 2,
      "arabic": "وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ",
      "translation": "আর কিসে আপনাকে জানাবে ‘রাতে যা আবির্ভূত হয়’ তা কী?",
      "pronunciation": "ওয়ামা আদরাকা মা আত্তারিক্ব।"
    },
    {
      "verse": 3,
      "arabic": "ٱلنَّجۡمُ ٱلثَّاقِبُ",
      "translation": "উজ্জ্বল নক্ষত্র।",
      "pronunciation": "আন্নাজমু আছ্ছাক্বিব।"
    },
    {
      "verse": 4,
      "arabic": "إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَيۡهَا حَافِظࣱ",
      "translation": "প্রত্যেক জীবের উপরই তত্ত্বাবধায়ক রয়েছে।",
      "pronunciation": "ইন কুল্লু নাফস ল্লাম্মা আলায়হা হাফিজ।"
    },
    {
      "verse": 5,
      "arabic": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ",
      "translation": "অতএব, মানুষ যেন চিন্তা করে দেখে তাকে কী থেকে সৃষ্টি করা হয়েছে!",
      "pronunciation": "ফালয়ানজুরি আল-ইনসানু মিম্মা খুলিক্ব।"
    },
    {
      "verse": 6,
      "arabic": "خُلِقَ مِن مَّآءࣲ دَافِقࣲ",
      "translation": "তাকে সৃষ্টি করা হয়েছে সবেগে স্থলিত পানি হতে,",
      "pronunciation": "খুলিক্বা মিন ম্মাহ দাফিক্ব।"
    },
    {
      "verse": 7,
      "arabic": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ",
      "translation": "এটা নির্গত হয় মেরুদণ্ড ও পঞ্জরাস্থির মধ্য থেকে।",
      "pronunciation": "ইয়াখরুজু মিন বায়নি আস্সুলবি ওয়ালত্তারাইব।"
    },
    {
      "verse": 8,
      "arabic": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ",
      "translation": "নিশ্চয় তিনি তাকে ফিরিয়ে আনতে সক্ষম।",
      "pronunciation": "ইন্নাহু আলা রাজইহি লাক্বাদির।"
    },
    {
      "verse": 9,
      "arabic": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ",
      "translation": "যেদিন গোপন বিষয় পরীক্ষিত হবে",
      "pronunciation": "ইয়াওমা তুবলা আস্সারাইর।"
    },
    {
      "verse": 10,
      "arabic": "فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ",
      "translation": "সেদিন তার কোনো সামর্থ্য থাকবে না এবং সাহায্যকারীও নয়।",
      "pronunciation": "ফামা লাহু মিন ক্বূত ওয়ালা নাসির।"
    },
    {
      "verse": 11,
      "arabic": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ",
      "translation": "শপথ আসমানের, যা ধারণ করে বৃষ্টি",
      "pronunciation": "ওয়াস-সামাঈ যাতি আর্রাজ‘।"
    },
    {
      "verse": 12,
      "arabic": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ",
      "translation": "এবং শপথ যমীনের, যা বিদীর্ণ হয়,",
      "pronunciation": "ওয়ালআরদি যাতি আস্সাদ‘।"
    },
    {
      "verse": 13,
      "arabic": "إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ",
      "translation": "নিশ্চয় আল-কুরআন মীমাংসাকারী বাণী।",
      "pronunciation": "ইন্নাহু লাক্বাওল ফাসল।"
    },
    {
      "verse": 14,
      "arabic": "وَمَا هُوَ بِٱلۡهَزۡلِ",
      "translation": "এবং এটা নিরর্থক নয়।",
      "pronunciation": "ওয়ামা হুওয়া বিলহাযল।"
    },
    {
      "verse": 15,
      "arabic": "إِنَّهُمۡ يَكِيدُونَ كَيۡدࣰا",
      "translation": "তারা ভীষণ ষড়যন্ত্র করে",
      "pronunciation": "ইন্নাহুম ইয়াকীদূনা কায়দা।"
    },
    {
      "verse": 16,
      "arabic": "وَأَكِيدُ كَيۡدࣰا",
      "translation": "এবং আমিও ভীষণ কৌশল করি।",
      "pronunciation": "ওয়াআকীদু কায়দা।"
    },
    {
      "verse": 17,
      "arabic": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا",
      "translation": "অতএব, কাফিরদেরকে অবকাশ দিন; তাদেরকে অবকাশ দিন কিছু কালের জন্য।",
      "pronunciation": "ফামাহ্হিলি আল-কাফিরীনা আমহিলহুম রূয়দ।"
    }
  ]
}
