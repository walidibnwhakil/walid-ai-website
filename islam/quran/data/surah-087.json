{
  "surah": 87,
  "verses": [
    {
      "verse": 1,
      "arabic": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى",
      "translation": "আপনি আপনার সুমহান রবের নামের পবিত্রতা ও মহিমা ঘোষণা করুন,"
    },
    {
      "verse": 2,
      "arabic": "ٱلَّذِي خَلَقَ فَسَوَّىٰ",
      "translation": "যিনি সৃষ্টি করেন অতঃপর সুঠাম করেন।"
    },
    {
      "verse": 3,
      "arabic": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ",
      "translation": "আর যিনি নির্ধারণ করেন অতঃপর পথনির্দেশ করেন,"
    },
    {
      "verse": 4,
      "arabic": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ",
      "translation": "আর যিনি তৃণাদি উৎপন্ন করেন,"
    },
    {
      "verse": 5,
      "arabic": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ",
      "translation": "পরে তা ধূসর আবর্জনায় পরিণত করেন।"
    },
    {
      "verse": 6,
      "arabic": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ",
      "translation": "শীঘ্রই আমরা আপনাকে পাঠ করাব, ফলে আপনি ভুলবেন না,"
    },
    {
      "verse": 7,
      "arabic": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ",
      "translation": "আল্লাহ্ যা ইচ্ছে করেন তা ছাড়া। নিশ্চয় তিনি জানেন যা প্ৰকাশ্য ও যা গোপনীয়।"
    },
    {
      "verse": 8,
      "arabic": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ",
      "translation": "আর আমরা আপনার জন্য সুগম করে দেব সহজ পথ।"
    },
    {
      "verse": 9,
      "arabic": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ",
      "translation": "অতঃপর উপদেশ যদি ফলপ্রসূ হয় তবে উপদেশ দিন;"
    },
    {
      "verse": 10,
      "arabic": "سَيَذَّكَّرُ مَن يَخۡشَىٰ",
      "translation": "যে ভয় করে সেই উপদেশ গ্ৰহণ করবে।"
    },
    {
      "verse": 11,
      "arabic": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى",
      "translation": "আর তা উপেক্ষা করবে যে নিতান্ত হতভাগ্য,"
    },
    {
      "verse": 12,
      "arabic": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ",
      "translation": "যে ভয়াবহ আগুনে দগ্ধ হবে,"
    },
    {
      "verse": 13,
      "arabic": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ",
      "translation": "তারপর সেখানে সে মরবেও না বাঁচবেও না।"
    },
    {
      "verse": 14,
      "arabic": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ",
      "translation": "অবশ্যই সাফল্য লাভ করবে যে পরিশুদ্ধ হয়।"
    },
    {
      "verse": 15,
      "arabic": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ",
      "translation": "এবং তার রবের নাম স্মরণ করে ও সালাত কায়েম করে।"
    },
    {
      "verse": 16,
      "arabic": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",
      "translation": "কিন্তু তোমরা দুনিয়ার জীবনকে প্রাধান্য দাও,"
    },
    {
      "verse": 17,
      "arabic": "وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰٓ",
      "translation": "অথচ আখিরাতই উৎকৃষ্ট ও স্থায়ী।"
    },
    {
      "verse": 18,
      "arabic": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ",
      "translation": "নিশ্চয় এটা আছে পূর্ববর্তী সহীফাসমূহে---"
    },
    {
      "verse": 19,
      "arabic": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ",
      "translation": "ইব্রাহীম ও মূসার সহীফাসমূহে।"
    }
  ]
}
