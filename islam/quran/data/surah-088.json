{
  "surah": 88,
  "verses": [
    {
      "verse": 1,
      "arabic": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ",
      "translation": "আপনার কাছে কি আচ্ছন্নকারীর (কিয়ামতের) সংবাদ এসেছে?",
      "pronunciation": "হাল আতাকা হাদীছু আলগাশীহ।"
    },
    {
      "verse": 2,
      "arabic": "وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ",
      "translation": "সেদিন অনেক চেহারা হবে অবনত,",
      "pronunciation": "উজূহ ইয়াওমাইযইন্ খাশি‘াতউন্।"
    },
    {
      "verse": 3,
      "arabic": "عَامِلَةࣱ نَّاصِبَةࣱ",
      "translation": "ক্লিষ্ট, ক্লান্ত,",
      "pronunciation": "‘ামিলাত ন্নাসিবাহ।"
    },
    {
      "verse": 4,
      "arabic": "تَصۡلَىٰ نَارًا حَامِيَةࣰ",
      "translation": "তারা প্রবেশ করবে জ্বলন্ত আগুনে;",
      "pronunciation": "তাসলা নারান্ হামীহ।"
    },
    {
      "verse": 5,
      "arabic": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ",
      "translation": "তাদেরকে অত্যন্ত উষ্ণ প্রস্রবণ থেকে পান করানো হবে;",
      "pronunciation": "তুসক্বা মিন ‘ায়নইন্ হনীহ।"
    },
    {
      "verse": 6,
      "arabic": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعࣲ",
      "translation": "তাদের জন্য খাদ্য থাকবে না কাঁটাযুক্ত গুল্ম ছাড়া,",
      "pronunciation": "ল্লায়সা লাহুম তা‘ামউন্ ইল্লা মিন দারী‘।"
    },
    {
      "verse": 7,
      "arabic": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ",
      "translation": "যা তাদেরকে পুষ্ট করবে না এবং তাদের ক্ষুধা নিবৃত্ত করবে না।",
      "pronunciation": "ল্লা ইয়ুসমিনু ওয়ালা ইয়ুগনী মিন জূ‘।"
    },
    {
      "verse": 8,
      "arabic": "وُجُوهࣱ يَوۡمَئِذࣲ نَّاعِمَةࣱ",
      "translation": "অনেক মুখমণ্ডল সেদিন হবে আনন্দোজ্জ্বল,",
      "pronunciation": "উজূহ ইয়াওমাইয ন্না‘িমাহ।"
    },
    {
      "verse": 9,
      "arabic": "لِّسَعۡيِهَا رَاضِيَةࣱ",
      "translation": "নিজেদের কাজের সাফল্যে পরিতৃপ্ত,",
      "pronunciation": "ল্লিসা‘ইহা রাদীহ।"
    },
    {
      "verse": 10,
      "arabic": "فِي جَنَّةٍ عَالِيَةࣲ",
      "translation": "সুউচ্চ জান্নাতে---",
      "pronunciation": "ফী জান্নাতইন্ ‘ালীহ।"
    },
    {
      "verse": 11,
      "arabic": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةࣰ",
      "translation": "সেখানে তারা অসার বাক্য শুনবে না,",
      "pronunciation": "ল্লা তাসমা‘ু ফীহা লাগীহ।"
    },
    {
      "verse": 12,
      "arabic": "فِيهَا عَيۡنࣱ جَارِيَةࣱ",
      "translation": "সেখানে থাকবে বহমান প্রস্রবণ,",
      "pronunciation": "ফীহা ‘ায়ন জারীহ।"
    },
    {
      "verse": 13,
      "arabic": "فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ",
      "translation": "সেখানে থাকবে উন্নত শয্যাসমূহ,",
      "pronunciation": "ফীহা সুরুর ম্মারফূ‘াহ।"
    },
    {
      "verse": 14,
      "arabic": "وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ",
      "translation": "আর প্রস্তুত থাকবে পানপাত্ৰ,",
      "pronunciation": "ওয়াআকওয়াব ম্মাওদূ‘াহ।"
    },
    {
      "verse": 15,
      "arabic": "وَنَمَارِقُ مَصۡفُوفَةࣱ",
      "translation": "সারি সারি উপাধান",
      "pronunciation": "ওয়ানামারিক্বু মাসফূফাহ।"
    },
    {
      "verse": 16,
      "arabic": "وَزَرَابِيُّ مَبۡثُوثَةٌ",
      "translation": "এবং বিছানা গালিচা;",
      "pronunciation": "ওয়াযারাবী মাবছূছাতউন্।"
    },
    {
      "verse": 17,
      "arabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ",
      "translation": "তবে কি তারা তাকিয়ে দেখে না উটের দিকে, কিভাবে তা সৃষ্টি করা হয়েছে?",
      "pronunciation": "আফালা ইয়ানজুরূনা ইলা আলইবিলি কায়ফা খুলিক্বাত।"
    },
    {
      "verse": 18,
      "arabic": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ",
      "translation": "এবং আসমানের দিকে, কিভাবে তা উর্ধ্বে স্থাপন করা হয়েছে?",
      "pronunciation": "ওয়াইলা আস-সামাঈ কায়ফা রুফি‘াত।"
    },
    {
      "verse": 19,
      "arabic": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ",
      "translation": "এবং পর্বতমালার দিকে, কিভাবে তা প্রতিষ্ঠিত করা হয়েছে?",
      "pronunciation": "ওয়াইলা আলজিবালি কায়ফা নুসিবাত।"
    },
    {
      "verse": 20,
      "arabic": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ",
      "translation": "এবং ভূতলের দিকে, কিভাবে তা বিস্তৃত করা হয়েছে?",
      "pronunciation": "ওয়াইলা আলআরদি কায়ফা সুতিহাত।"
    },
    {
      "verse": 21,
      "arabic": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرࣱ",
      "translation": "অতএব আপনি উপদেশ দিন; আপনি তো কেবল একজন উপদেশ দাতা,",
      "pronunciation": "ফাযাক্কির ইন্নামা আনতা মুযাক্কির।"
    },
    {
      "verse": 22,
      "arabic": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ",
      "translation": "আপনি তাদের উপর শক্তি প্রয়োগকারী নন।",
      "pronunciation": "ল্লাসতা ‘ালায়হিম বিমুসায়তিরইন্।"
    },
    {
      "verse": 23,
      "arabic": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "translation": "তবে কেউ মুখ ফিরিয়ে নিলে ও কুফরী করলে",
      "pronunciation": "ইল্লা মান তাওয়াল্লা ওয়াকাফার।"
    },
    {
      "verse": 24,
      "arabic": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ",
      "translation": "আল্লাহ্ তাদেরকে দেবেন মহাশাস্তি।",
      "pronunciation": "ফায়ু‘ায্যিবুহু আল্লাহু আল‘াযাবা আলআকবার।"
    },
    {
      "verse": 25,
      "arabic": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ",
      "translation": "নিশ্চয় তাদের ফিরে আসা আমাদেরই কাছে;",
      "pronunciation": "ইন্না ইলায়না ইয়াবাহুম।"
    },
    {
      "verse": 26,
      "arabic": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم",
      "translation": "তারপর তাদের হিসেব-নিকেশ আমাদেরই কাজ।",
      "pronunciation": "ছুম্মা ইন্না ‘ালায়না হিসাবাহুম।"
    }
  ]
}
