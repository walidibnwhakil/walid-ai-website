{
  "surah": 92,
  "verses": [
    {
      "verse": 1,
      "arabic": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ",
      "pronunciation": "ওয়াল্লায়লি ইযা ইয়াগশ।",
      "translation": "শপথ রাতের, যখন সে আচ্ছন্ন করে,"
    },
    {
      "verse": 2,
      "arabic": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "pronunciation": "ওয়ালন্নাহারি ইযা তাজাল্ল।",
      "translation": "শপথ দিনের, যখন তা উদ্ভাসিত হয়"
    },
    {
      "verse": 3,
      "arabic": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",
      "pronunciation": "ওয়ামা খালাক্বা আয্যাকারা ওয়ালউনছ।",
      "translation": "শপথ তাঁর, যিনি নর ও নারী সৃষ্টি করেছেন-"
    },
    {
      "verse": 4,
      "arabic": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ",
      "pronunciation": "ইন্না সা‘য়াকুম লাশাত্ত।",
      "translation": "নিশ্চয় তোমাদের কর্মপ্রচেষ্টা বিভিন্ন প্রকৃতির।"
    },
    {
      "verse": 5,
      "arabic": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ",
      "pronunciation": "ফাআম্মা মান আ‘তা ওয়াত্তাক্ব।",
      "translation": "কাজেই কেউ দান করলে, তাকওয়া অবলম্বন করলে"
    },
    {
      "verse": 6,
      "arabic": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ",
      "pronunciation": "ওয়াসাদ্দাক্বা বিলহুসন।",
      "translation": "এবং যা উত্তম তা সত্য বলে গ্ৰহণ করলে,"
    },
    {
      "verse": 7,
      "arabic": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ",
      "pronunciation": "ফাসানুয়াস্সিরুহু লিলয়ুসর।",
      "translation": "আমরা তার জন্য সুগম করে দেব সহজ পথ।"
    },
    {
      "verse": 8,
      "arabic": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ",
      "pronunciation": "ওয়াআম্মা মান বাখিলা ওয়াসতাগন।",
      "translation": "আর কেউ কার্পণ্য করলে এবং নিজকে অমুখাপেক্ষী মনে করলে,"
    },
    {
      "verse": 9,
      "arabic": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ",
      "pronunciation": "ওয়াকায্যাবা বিলহুসন।",
      "translation": "আর যা উত্তম তাতে মিথ্যারোপ করলে,"
    },
    {
      "verse": 10,
      "arabic": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ",
      "pronunciation": "ফাসানুয়াস্সিরুহু লিল‘ুসর।",
      "translation": "তার জন্য আমরা সুগম করে দেব কঠোর পথ।"
    },
    {
      "verse": 11,
      "arabic": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "pronunciation": "ওয়ামা ইয়ুগনী ‘ানহু মালুহু ইযা তারাদ্দ।",
      "translation": "আর তার সম্পদ তার কোনো কাজে আসবে না, যখন সে ধ্বংস হবে।"
    },
    {
      "verse": 12,
      "arabic": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ",
      "pronunciation": "ইন্না ‘ালায়না লালহুদ।",
      "translation": "নিশ্চয় আমাদের কাজ শুধু পথনির্দেশ করা,"
    },
    {
      "verse": 13,
      "arabic": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ",
      "pronunciation": "ওয়াইন্না লানা লালখিরাতা ওয়ালউওয়াল।",
      "translation": "আর আমরাই তো মালিক আখেরাতের ও প্রথমটির (দুনিয়ার)।"
    },
    {
      "verse": 14,
      "arabic": "فَأَنذَرۡتُكُمۡ نَارࣰا تَلَظَّىٰ",
      "pronunciation": "ফাআনযারতুকুম নার তালাজ্জ।",
      "translation": "অতঃপর আমি তোমাদেরকে লেলিহান আগুন সম্পর্কে সতর্ক করে দিয়েছি।"
    },
    {
      "verse": 15,
      "arabic": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى",
      "pronunciation": "লা ইয়াসলাহা ইল্লা আলআশক্ব।",
      "translation": "তাতে প্ৰবেশ করবে সে-ই, যে নিতান্ত হতভাগ্য,"
    },
    {
      "verse": 16,
      "arabic": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ",
      "pronunciation": "আল্লাযী কায্যাবা ওয়াতাওয়াল্ল।",
      "translation": "যে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।"
    },
    {
      "verse": 17,
      "arabic": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى",
      "pronunciation": "ওয়াসায়ুজান্নাবুহা আলআতক্ব।",
      "translation": "আর তা থেকে দূরে রাখা হবে পরম মুত্তাকীকে,"
    },
    {
      "verse": 18,
      "arabic": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ",
      "pronunciation": "আল্লাযী ইয়ুতী মালাহু ইয়াতাযাক্ক।",
      "translation": "যে স্বীয় সম্পদ দান করে আতশুদ্ধির জন্য"
    },
    {
      "verse": 19,
      "arabic": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰٓ",
      "pronunciation": "ওয়ামা লিআহাদইন্ ‘িনদাহু মিন ন্নি‘মাত তুজয।",
      "translation": "এবং তার প্রতি কারও এমন কোনো অনুগ্রহ নেই যার প্রতিদান দিতে হবে,"
    },
    {
      "verse": 20,
      "arabic": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ",
      "pronunciation": "ইল্লা ইবতিগাহ ওয়াজহি রাব্বিহি আলআ‘ল।",
      "translation": "শুধু তার মহান রবের সস্তুষ্টির প্ৰত্যাশায়;"
    },
    {
      "verse": 21,
      "arabic": "وَلَسَوۡفَ يَرۡضَىٰ",
      "pronunciation": "ওয়ালাসাওফা ইয়ারদ।",
      "translation": "আর অচিরেই সে সস্তুষ্ট হবে।"
    }
  ]
}
