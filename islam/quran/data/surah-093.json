{
  "surah": 93,
  "verses": [
    {
      "verse": 1,
      "arabic": "وَٱلضُّحَىٰ",
      "translation": "শপথ পূর্বাহ্নের,"
    },
    {
      "verse": 2,
      "arabic": "وَٱلَّيۡلِ إِذَا سَجَىٰ",
      "translation": "শপথ রাতের যখন তা হয় নিঝুম –"
    },
    {
      "verse": 3,
      "arabic": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "translation": "আপনার রব আপনাকে পরিত্যাগ করেন নি এবং শক্ৰতাও করেন নি।"
    },
    {
      "verse": 4,
      "arabic": "وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ",
      "translation": "আর অবশ্যই আপনার জন্য পরবর্তী সময় পূর্ববতী সময়ের চেয়ে শ্রেয়।"
    },
    {
      "verse": 5,
      "arabic": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ",
      "translation": "আর অচিরেই আপনার রব আপনাকে অনুগ্রহ দান করবেন, ফলে আপনি সন্তুষ্ট হবেন।"
    },
    {
      "verse": 6,
      "arabic": "أَلَمۡ يَجِدۡكَ يَتِيمࣰا فَـَٔاوَىٰ",
      "translation": "তিনি কি আপনাকে ইয়াতীম অবস্থায় পান নি? অতঃপর তিনি আশ্রয় দিয়েছেন;"
    },
    {
      "verse": 7,
      "arabic": "وَوَجَدَكَ ضَآلࣰّا فَهَدَىٰ",
      "translation": "আর তিনি আপনাকে পেলেন পথ সম্পর্কে অনবহিত, অতঃপর তিনি পথের নির্দেশ দিলেন।"
    },
    {
      "verse": 8,
      "arabic": "وَوَجَدَكَ عَآئِلࣰا فَأَغۡنَىٰ",
      "translation": "আর তিনি আপনাকে পেলেন নিঃস্ব অবস্থায়, অতঃপর অভাব মুক্ত করলেন।"
    },
    {
      "verse": 9,
      "arabic": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ",
      "translation": "কাজেই আপনি ইয়াতীমের প্রতি কঠোর হবেন না।"
    },
    {
      "verse": 10,
      "arabic": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ",
      "translation": "আর প্রার্থীকে ভর্ৎসনা করবেন না।"
    },
    {
      "verse": 11,
      "arabic": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ",
      "translation": "আর আপনি আপনার রবের অনুগ্রহের কথা জানিয়ে দিন।"
    }
  ]
}
