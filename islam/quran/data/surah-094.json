{
  "surah": 94,
  "verses": [
    {
      "verse": 1,
      "arabic": "أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ",
      "translation": "আমরা কি আপনার বক্ষ আপনার কল্যাণে প্রশস্ত করে দেইনি?",
      "pronunciation": "আলাম নাশরাহ লাকা সদরাক।"
    },
    {
      "verse": 2,
      "arabic": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ",
      "translation": "আর আমরা অপসারণ করেছি আপনার ভার,",
      "pronunciation": "ওয়া ওয়াদা‘না আনকা উইযরাক।"
    },
    {
      "verse": 3,
      "arabic": "ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ",
      "translation": "যা আপনার পিঠ ভেঙ্গে দিচ্ছিল।",
      "pronunciation": "আল্লাযী আনকাদা যাহরাক।"
    },
    {
      "verse": 4,
      "arabic": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ",
      "translation": "আর আমরা আপনার (মর্যাদা বৃদ্ধির) জন্য আপনার স্মরণকে সমুন্নত করেছি।",
      "pronunciation": "ওয়ারাফা‘না লাকা যিকরাক।"
    },
    {
      "verse": 5,
      "arabic": "فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا",
      "translation": "সুতরাং কষ্টের সাথেই তো স্বস্তি আছে,",
      "pronunciation": "ফা ইন্না মা‘আল-উসরি ইউসরা।"
    },
    {
      "verse": 6,
      "arabic": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰا",
      "translation": "নিশ্চয় কষ্টের সাথেই স্বস্তি আছে।",
      "pronunciation": "ইন্না মা‘আল-উসরি ইউসরা।"
    },
    {
      "verse": 7,
      "arabic": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ",
      "translation": "অতএব আপনি যখনই অবসর পান তখনই কঠোর ইবাদাতে রত হোন",
      "pronunciation": "ফাইযা ফারাগতা ফানসাব।"
    },
    {
      "verse": 8,
      "arabic": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب",
      "translation": "আর আপনার রবের প্রতি গভীর মনোযোগী হোন।",
      "pronunciation": "ওয়াইলা রাব্বিকা ফারগাব।"
    }
  ]
}
