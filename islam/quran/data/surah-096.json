{
  "surah": 96,
  "verses": [
    {
      "verse": 1,
      "arabic": "ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ",
      "translation": "পড়ুন আপনার রবের নামে, যিনি সৃষ্টি করেছেন –",
      "pronunciation": "ইকরা বিসমি রাব্বিকাল্লাযী খালাক।"
    },
    {
      "verse": 2,
      "arabic": "خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ",
      "translation": "সৃষ্টি করেছেন মানুষকে ‘আলাক’ হতে।",
      "pronunciation": "খালাকাল-ইনসানা মিন আলাক।"
    },
    {
      "verse": 3,
      "arabic": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ",
      "translation": "পড়ুন, আর আপনার রব মহামহিমান্বিত",
      "pronunciation": "ইকরা ওয়া রাব্বুকাল-আকরাম।"
    },
    {
      "verse": 4,
      "arabic": "ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ",
      "translation": "যিনি কলমের সাহায্যে শিক্ষা দিয়েছেন –",
      "pronunciation": "আল্লাযী আল্লামা বিল-কালাম।"
    },
    {
      "verse": 5,
      "arabic": "عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ",
      "translation": "শিক্ষা দিয়েছেন মানুষকে যা সে জানত না।",
      "pronunciation": "আল্লামাল-ইনসানা মা লাম ইয়া‘লাম।"
    },
    {
      "verse": 6,
      "arabic": "كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ",
      "translation": "বাস্তবেই, মানুষ সীমালঙ্ঘনই করে থাকে,",
      "pronunciation": "কাল্লা ইন্নাল-ইনসানা লায়াতগা।"
    },
    {
      "verse": 7,
      "arabic": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ",
      "translation": "কারণ সে নিজকে অমুখাপেক্ষী মনে করে।",
      "pronunciation": "আর রাআহুস্তাগনা।"
    },
    {
      "verse": 8,
      "arabic": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ",
      "translation": "নিশ্চয় আপনার রবের কাছেই ফিরে যাওয়া।",
      "pronunciation": "ইন্না ইলা রাব্বিকার-রুজ‘আ।"
    },
    {
      "verse": 9,
      "arabic": "أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ",
      "translation": "আমাকে জানাও (এবং আশ্চর্য হও) তার সম্পর্কে, যে বাধা দেয়",
      "pronunciation": "আরাআইতাল্লাযী ইয়ানহা।"
    },
    {
      "verse": 10,
      "arabic": "عَبۡدًا إِذَا صَلَّىٰٓ",
      "translation": "এক বান্দাকে- যখন তিনি সালাত আদায় করেন।",
      "pronunciation": "আবদান ইযা সাল্লা।"
    },
    {
      "verse": 11,
      "arabic": "أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ",
      "translation": "আমাকে বল! যদি তিনি হিদায়াতের উপর থাকেন",
      "pronunciation": "আরাআইতা ইন কানা আলাল-হুদা।"
    },
    {
      "verse": 12,
      "arabic": "أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ",
      "translation": "অথবা তাক্ওয়ার নির্দেশ দেন; (তারপরও সে কিভাবে বাধা দেয়? !)",
      "pronunciation": "আও আমারা বিত-তাকওয়া।"
    },
    {
      "verse": 13,
      "arabic": "أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "translation": "আমাকে বল! যদি সে (নিষেধকারী) মিথ্যারোপ করে এবং মুখ ফিরিয়ে নেয়,",
      "pronunciation": "আরাআইতা ইন কাযযাবা ওয়া তাওয়াল্লা।"
    },
    {
      "verse": 14,
      "arabic": "أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "translation": "সে কি জানে না যে, নিশ্চয় আল্লাহ্ দেখেন? !",
      "pronunciation": "আলাম ইয়া‘লাম বি আন্নাল্লাহা ইয়ারা।"
    },
    {
      "verse": 15,
      "arabic": "كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ",
      "translation": "কখনো নয়, সে যদি বিরত না হয় তবে আমরা তাকে অবশ্যই হেঁচড়ে নিয়ে যাব, মাথার সামনের চুলের গুচ্ছ ধরে-----",
      "pronunciation": "কাল্লা লাঈল্লাম ইয়ানতাহি লানাসফা‘আম বিন-নাসিয়াহ।"
    },
    {
      "verse": 16,
      "arabic": "نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ",
      "translation": "মিথ্যাচারী, পাপিষ্ঠ সম্মুখ-চুলের-গুচ্ছ।",
      "pronunciation": "নাসিয়াতিন কাযিবাতিন খাতিয়াহ।"
    },
    {
      "verse": 17,
      "arabic": "فَلۡيَدۡعُ نَادِيَهُۥ",
      "translation": "অতএব সে তার পারিষদকে ডেকে আনুক!",
      "pronunciation": "ফালইয়াদ‘উ নাদিয়াহ।"
    },
    {
      "verse": 18,
      "arabic": "سَنَدۡعُ ٱلزَّبَانِيَةَ",
      "translation": "শীঘ্রই আমরা ডেকে আনব যাবানিয়াদেরকে।",
      "pronunciation": "সানাদ‘উয-যাবানিয়াহ।"
    },
    {
      "verse": 19,
      "arabic": "كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩",
      "translation": "কখনো নয়! আপনি তার অনুসরণ করবেন না। আর আপনি সাজ্দা করুন এবং নিকটবর্তী হোন।",
      "pronunciation": "কাল্লা লা তুতি‘হু ওয়াসজুদ ওয়াকতারিব।"
    }
  ]
}
