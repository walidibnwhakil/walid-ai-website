{
  "surah": 100,
  "verses": [
    {
      "verse": 1,
      "arabic": "وَٱلۡعَٰدِيَٰتِ ضَبۡحࣰا",
      "translation": "শপথ ঊর্ধ্বশ্বাসে ধাবমান অশ্বরাজির,",
      "pronunciation": "ওয়াল-আদিয়াতি দাবহা।"
    },
    {
      "verse": 2,
      "arabic": "فَٱلۡمُورِيَٰتِ قَدۡحࣰا",
      "translation": "অতঃপর যারা ক্ষুরের আঘাতে অগ্নি-স্ফুলিঙ্গ বিচ্ছুরিত করে,",
      "pronunciation": "ফাল-মূরিয়াতি কাদহা।"
    },
    {
      "verse": 3,
      "arabic": "فَٱلۡمُغِيرَٰتِ صُبۡحࣰا",
      "translation": "অতঃপর যারা অভিযান করে প্রভাতকালে,",
      "pronunciation": "ফাল-মুগীরাতি সুবহা।"
    },
    {
      "verse": 4,
      "arabic": "فَأَثَرۡنَ بِهِۦ نَقۡعࣰا",
      "translation": "ফলে তারা তা দ্বারা ধূলি উৎক্ষিপ্ত করে;",
      "pronunciation": "ফা আছারনা বিহী নাকআ।"
    },
    {
      "verse": 5,
      "arabic": "فَوَسَطۡنَ بِهِۦ جَمۡعًا",
      "translation": "অতঃপর তা দ্বারা শত্রু দলের অভ্যন্তরে ঢুকে পরে।",
      "pronunciation": "ফা ওয়াসাতনা বিহী জামআ।"
    },
    {
      "verse": 6,
      "arabic": "إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ",
      "translation": "নিশ্চয় মানুষ তার রবের প্রতি বড়ই অকৃতজ্ঞ",
      "pronunciation": "ইন্নাল-ইনসানা লিরাব্বিহী লাকানূদ।"
    },
    {
      "verse": 7,
      "arabic": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ",
      "translation": "আর নিশ্চয় সে এ বিষয়ে সাক্ষী,",
      "pronunciation": "ওয়া ইন্নাহু আলা যালিকা লাশাহীদ।"
    },
    {
      "verse": 8,
      "arabic": "وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ",
      "translation": "আর নিশ্চয় সে ধন-সম্পদের আসক্তিতে প্রবল।",
      "pronunciation": "ওয়া ইন্নাহু লিহুব্বিল-খাইরি লাশাদীদ।"
    },
    {
      "verse": 9,
      "arabic": "۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ",
      "translation": "তবে কি সে জানে না যখন কবরে যা আছে তা উত্থিত হবে,",
      "pronunciation": "আফালা ইয়া‘লামু ইযা বু‘ছিরা মা ফিল-কুবূর।"
    },
    {
      "verse": 10,
      "arabic": "وَحُصِّلَ مَا فِي ٱلصُّدُورِ",
      "translation": "আর অন্তরে যা আছে তা প্রকাশ করা হবে?",
      "pronunciation": "ওয়া হুসসিলা মা ফিস-সুদূর।"
    },
    {
      "verse": 11,
      "arabic": "إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذࣲ لَّخَبِيرُۢ",
      "translation": "নিশ্চয় তাদের রব সেদিন তাদের ব্যাপারে সবিশেষ অবহিত।",
      "pronunciation": "ইন্না রাব্বাহুম বিহিম ইয়াওমাইযিল লাখাবীর।"
    }
  ]
}
