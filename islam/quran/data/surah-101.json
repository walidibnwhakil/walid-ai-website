{
  "surah": 101,
  "verses": [
    {
      "verse": 1,
      "arabic": "ٱلۡقَارِعَةُ",
      "pronunciation": "আল-কারিআহ।",
      "translation": "ভীতিপ্ৰদ মহা বিপদ"
    },
    {
      "verse": 2,
      "arabic": "مَا ٱلۡقَارِعَةُ",
      "pronunciation": "মাল-কারিআহ।",
      "translation": "ভীতিপ্ৰদ মহা বিপদ কী?"
    },
    {
      "verse": 3,
      "arabic": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ",
      "pronunciation": "ওয়ামা আদরাকা মাল-কারিআহ।",
      "translation": "আর ভীতিপ্ৰদ মহা বিপদ সম্পর্কে আপনাকে কিসে জানাবে?"
    },
    {
      "verse": 4,
      "arabic": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ",
      "pronunciation": "ইয়াওমা ইয়াকূনুন-নাসু কাল-ফারাশিল-মাবসূছ।",
      "translation": "সেদিন মানুষ হবে বিক্ষিপ্ত পতঙ্গের মত"
    },
    {
      "verse": 5,
      "arabic": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ",
      "pronunciation": "ওয়া তাকূনুল-জিবালু কাল-‘ইহ্নিল-মানফূশ।",
      "translation": "আর পর্বতসমূহ হবে ধুনিত রঙ্গিন পশমের মত।"
    },
    {
      "verse": 6,
      "arabic": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ",
      "pronunciation": "ফা আম্মা মান ছাকুলাত মাওয়াযীনুহু।",
      "translation": "অতঃপর যার পাল্লাসমূহ ভারী হবে,"
    },
    {
      "verse": 7,
      "arabic": "فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ",
      "pronunciation": "ফাহুয়া ফী ‘ঈশাতির-রাদিয়াহ।",
      "translation": "সে তো থাকবে সন্তোষজনক জীবনে।"
    },
    {
      "verse": 8,
      "arabic": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ",
      "pronunciation": "ওয়া আম্মা মান খাফ্ফাত মাওয়াযীনুহু।",
      "translation": "আর যার পাল্লাসমূহ হাল্কা হবে"
    },
    {
      "verse": 9,
      "arabic": "فَأُمُّهُۥ هَاوِيَةࣱ",
      "pronunciation": "ফা উম্মুহু হাবিয়াহ।",
      "translation": "তার স্থান হবে ‘হাওয়িয়াহ্’।"
    },
    {
      "verse": 10,
      "arabic": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ",
      "pronunciation": "ওয়া মা আদরাকা মা হিয়াহ।",
      "translation": "আর আপনাকে কিসে জানাবে সেটা কী?"
    },
    {
      "verse": 11,
      "arabic": "نَارٌ حَامِيَةُۢ",
      "pronunciation": "নারুন হামিয়াহ।",
      "translation": "অত্যন্ত উত্তপ্ত আগুন।"
    }
  ]
}
