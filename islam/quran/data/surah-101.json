{"surah":101,"verses":[{"verse":1,"arabic":"ٱلۡقَارِعَةُ","translation":"ভীতিপ্ৰদ মহা বিপদ [১]"},{"verse":2,"arabic":"مَا ٱلۡقَارِعَةُ","translation":"ভীতিপ্ৰদ মহা বিপদ কী?"},{"verse":3,"arabic":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","translation":"আর ভীতিপ্ৰদ মহা বিপদ সম্পর্কে আপনাকে কিসে জানাবে?"},{"verse":4,"arabic":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","translation":"সেদিন মানুষ হবে বিক্ষিপ্ত পতঙ্গের মত [১]"},{"verse":5,"arabic":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","translation":"আর পর্বতসমূহ হবে ধুনিত রঙ্গিন পশমের মত [১]।"},{"verse":6,"arabic":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","translation":"অতঃপর যার পাল্লাসমূহ [১] ভারী হবে [২],"},{"verse":7,"arabic":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","translation":"সে তো থাকবে সন্তোষজনক জীবনে।"},{"verse":8,"arabic":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","translation":"আর যার পাল্লাসমূহ হাল্কা হবে [১]"},{"verse":9,"arabic":"فَأُمُّهُۥ هَاوِيَةٞ","translation":"তার স্থান হবে ‘হাওয়িয়াহ্’ [১]।"},{"verse":10,"arabic":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","translation":"আর আপনাকে কিসে জানাবে সেটা কী?"},{"verse":11,"arabic":"نَارٌ حَامِيَةُۢ","translation":"অত্যন্ত উত্তপ্ত আগুন [১]।"}]}
