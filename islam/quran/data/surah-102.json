{
  "surah": 102,
  "verses": [
    {
      "verse": 1,
      "arabic": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",
      "translation": "তোমাদেরকে মোহাচ্ছন্ন রাখে প্রাচুর্যের প্রতিযোগিতা",
      "pronunciation": "আলহাকুমুত-তাকাছুর।"
    },
    {
      "verse": 2,
      "arabic": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",
      "translation": "যতক্ষণ না তোমরা কবরে উপনীত হও।",
      "pronunciation": "হাত্তা যুরতুমুল-মাকাবির।"
    },
    {
      "verse": 3,
      "arabic": "كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "translation": "কখনো নয়, তোমরা শীঘ্রই জানতে পারবে;",
      "pronunciation": "কাল্লা সাওফা তা‘লামূন।"
    },
    {
      "verse": 4,
      "arabic": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "translation": "তারপর, কখনো নয়, তোমরা শীঘ্রই জানতে পারবে:",
      "pronunciation": "ছুম্মা কাল্লা সাওফা তা‘লামূন।"
    },
    {
      "verse": 5,
      "arabic": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ",
      "translation": "কখনো নয়! যদি তোমরা নিশ্চিত জ্ঞানে জ্ঞানী হতে---",
      "pronunciation": "কাল্লা লাও তা‘লামূনা ‘ইলমাল-ইয়াকীন।"
    },
    {
      "verse": 6,
      "arabic": "لَتَرَوُنَّ ٱلۡجَحِيمَ",
      "translation": "অবশ্যই তোমরা জাহান্নাম দেখবে;",
      "pronunciation": "লাতারাওয়ুন্নাল-জাহীম।"
    },
    {
      "verse": 7,
      "arabic": "ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ",
      "translation": "তারপর অবশ্যই তোমরা তা দেখবে চাক্ষুষ প্রত্যয়ে,",
      "pronunciation": "ছুম্মা লাতারাওয়ুন্নাহা ‘আইনাল-ইয়াকীন।"
    },
    {
      "verse": 8,
      "arabic": "ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "translation": "তারপর অবশ্যই সেদিন তোমাদেরকে নেয়ামত সম্পর্কে প্রশ্ন করা হবে।",
      "pronunciation": "ছুম্মা লাতুসআলুন্না ইয়াওমাইযিন ‘আনিন্নাঈম।"
    }
  ]
}
