{
  "surah": 104,
  "verses": [
    {
      "verse": 1,
      "arabic": "وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ",
      "translation": "দুর্ভোগ প্রত্যেকের, যে পিছনে ও সামনে লোকের নিন্দা করে,"
    },
    {
      "verse": 2,
      "arabic": "ٱلَّذِي جَمَعَ مَالࣰا وَعَدَّدَهُۥ",
      "translation": "যে সম্পদ জমায় ও তা বার বার গণনা করে;"
    },
    {
      "verse": 3,
      "arabic": "يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ",
      "translation": "সে ধারণা করে যে, তার অর্থ তাকে অমর করে রাখবে;"
    },
    {
      "verse": 4,
      "arabic": "كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ",
      "translation": "কখনও না, সে অবশ্যই নিক্ষিপ্ত হবে হুতামায়;"
    },
    {
      "verse": 5,
      "arabic": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ",
      "translation": "আর আপনাকে কিসে জানাবে হুতামা কী?"
    },
    {
      "verse": 6,
      "arabic": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ",
      "translation": "এটা আল্লাহর প্রজ্বলিত আগুন,"
    },
    {
      "verse": 7,
      "arabic": "ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ",
      "translation": "যা হৃদয়কে গ্ৰাস করবে;"
    },
    {
      "verse": 8,
      "arabic": "إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ",
      "translation": "নিশ্চয় এটা তাদেরকে পরিবেষ্টন করে রাখবে"
    },
    {
      "verse": 9,
      "arabic": "فِي عَمَدࣲ مُّمَدَّدَةِۭ",
      "translation": "দীর্ঘায়িত স্তম্ভসমূহে।"
    }
  ]
}
