{
  "surah": 107,
  "verses": [
    {
      "verse": 1,
      "arabic": "أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ",
      "translation": "আপনি কি দেখেছেন তাকে, যে দীনকে অস্বীকার করে?",
      "pronunciation": "আরা’আইতাল্লাযী ইউকাযযিবু বিদ্দীন।"
    },
    {
      "verse": 2,
      "arabic": "فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ",
      "translation": "সে তো সে-ই, যে ইয়াতীমকে রূঢ়ভাবে তাড়িয়ে দেয়",
      "pronunciation": "ফাযালিকাল্লাযী ইয়াদু‘উল-ইয়াতীম।"
    },
    {
      "verse": 3,
      "arabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",
      "translation": "আর সে উদ্ধুদ্ধ করে না মিসকীনদের খাদ্য দানে।",
      "pronunciation": "ওয়া লা ইয়াহুদ্দু ‘আলা তা‘আমিল-মিসকীন।"
    },
    {
      "verse": 4,
      "arabic": "فَوَيۡلࣱ لِّلۡمُصَلِّينَ",
      "translation": "কাজেই দুর্ভোগ সে সালাত আদায়কারীদের,",
      "pronunciation": "ফাওয়াইলুল লিল-মুসাল্লীন।"
    },
    {
      "verse": 5,
      "arabic": "ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ",
      "translation": "যারা তাদের সালাত সম্বন্ধে উদাসীন,",
      "pronunciation": "আল্লাযীনা হুম ‘আন সালাতিহিম সাহূন।"
    },
    {
      "verse": 6,
      "arabic": "ٱلَّذِينَ هُمۡ يُرَآءُونَ",
      "translation": "যারা লোক দেখানোর জন্য তা করে",
      "pronunciation": "আল্লাযীনা হুম ইউরাঊন।"
    },
    {
      "verse": 7,
      "arabic": "وَيَمۡنَعُونَ ٱلۡمَاعُونَ",
      "translation": "এবং মা‘উন প্ৰদান করতে বিরত থাকে।",
      "pronunciation": "ওয়া ইয়ামনা‘ঊনাল-মা‘ঊন।"
    }
  ]
}
