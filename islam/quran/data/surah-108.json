{
  "surah": 108,
  "verses": [
    {
      "verse": 1,
      "arabic": "إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ",
      "translation": "নিশ্চয় আমরা আপনাকে কাউছার দান করেছি।",
      "pronunciation": "ইন্না আ‘তাইনাকাল-কাওসার।"
    },
    {
      "verse": 2,
      "arabic": "فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ",
      "translation": "কাজেই আপনি আপনার রবের উদ্দেশ্যে সালাত আদায় করুন এবং কুরবানী করুন।",
      "pronunciation": "ফাসাল্লি লিরাব্বিকা ওয়ানহার।"
    },
    {
      "verse": 3,
      "arabic": "إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ",
      "translation": "নিশ্চয় আপনার প্রতি বিদ্বেষ পোষণকারীই তো নির্বংশ।",
      "pronunciation": "ইন্না শানিআকা হুয়াল-আবতার।"
    }
  ]
}
