{
  "surah": 112,
  "verses": [
    {
      "verse": 1,
      "arabic": "قُلۡ هُوَ ٱللَّهُ أَحَدٌ",
      "pronunciation": "ক্বুল হূ আল্লাহু আহাদউন্।",
      "translation": "বলুন, ‘তিনি আল্লাহ্, এক-অদ্বিতীয়,"
    },
    {
      "verse": 2,
      "arabic": "ٱللَّهُ ٱلصَّمَدُ",
      "pronunciation": "আল্লাহু আস্সামাদ।",
      "translation": "‘আল্লাহ্ হচ্ছেন ‘সামাদ' (তিনি কারো মুখাপেক্ষী নন, সকলেই তাঁর মুখাপেক্ষী);"
    },
    {
      "verse": 3,
      "arabic": "لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ",
      "pronunciation": "লাম ইয়ালিদ ওয়ালাম ইয়ুলাদ।",
      "translation": "তিনি কাউকেও জন্ম দেননি এবং তাঁকেও জন্ম দেয়া হয়নি,"
    },
    {
      "verse": 4,
      "arabic": "وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ",
      "pronunciation": "ওয়ালাম ইয়াকুন ল্লাহু কুফূ আহাদ।",
      "translation": "‘এবং তাঁর সমতুল্য কেউই নেই।’"
    }
  ]
}
