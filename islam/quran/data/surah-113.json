{
  "surah": 113,
  "verses": [
    {
      "verse": 1,
      "arabic": "قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ",
      "pronunciation": "ক্বুল আ‘ূযু বিরাব্বি আলফালাক্ব।",
      "translation": "বলুন, ‘আমি আশ্রয় প্রার্থনা করছি ঊষার রবের"
    },
    {
      "verse": 2,
      "arabic": "مِن شَرِّ مَا خَلَقَ",
      "pronunciation": "মিন শার্রি মা খালাক্ব।",
      "translation": "তিনি যা সৃষ্টি করেছেন তার অনিষ্ট হতে,"
    },
    {
      "verse": 3,
      "arabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "pronunciation": "ওয়ামিন শার্রি গাসিক্বইন্ ইযা ওয়াক্বাব।",
      "translation": "আর অনিষ্ট হতে রাতের অন্ধকারের, যখন তা গভীর হয়"
    },
    {
      "verse": 4,
      "arabic": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ",
      "pronunciation": "ওয়ামিন শার্রি আন্নাফ্ফাছাতি ফী আল‘ুক্বাদ।",
      "translation": "আর অনিষ্ট হতে গিরায় ফুঁক দেয় এমনদের,"
    },
    {
      "verse": 5,
      "arabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "pronunciation": "ওয়ামিন শার্রি হাসিদইন্ ইযা হাসাদ।",
      "translation": "আর অনিষ্ট হতে হিংসুকের, যখন সে হিংসা করে।’"
    }
  ]
}
