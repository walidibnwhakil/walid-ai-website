{
  "surah": 114,
  "verses": [
    {
      "verse": 1,
      "arabic": "قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "translation": "বলুন, ‘আমি আশ্ৰয় প্রার্থনা করছি মানুষের রবের,"
    },
    {
      "verse": 2,
      "arabic": "مَلِكِ ٱلنَّاسِ",
      "translation": "মানুষের অধিপতির,"
    },
    {
      "verse": 3,
      "arabic": "إِلَٰهِ ٱلنَّاسِ",
      "translation": "মানুষের ইলাহের কাছে"
    },
    {
      "verse": 4,
      "arabic": "مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ",
      "translation": "আত্মগোপনকারী কুমন্ত্রণাদাতার অনিষ্ট হতে,"
    },
    {
      "verse": 5,
      "arabic": "ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ",
      "translation": "যে কুমন্ত্রণা দেয় মানুষের অন্তরে,"
    },
    {
      "verse": 6,
      "arabic": "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ",
      "translation": "জিনের মধ্য থেকে এবং মানুষের মধ্য থেকে।’"
    }
  ]
}
